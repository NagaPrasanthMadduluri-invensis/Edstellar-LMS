# Copy to .env.local and fill in. Never commit the real file.
#
# This is the frontend's ONLY configuration. It holds no database credentials
# and no signing secret — the API is the sole authority on identity.
#
# NEXT_PUBLIC_* values are inlined at build / dev-server-start time, not read
# per request. After changing this, restart the dev server or rebuild.

NEXT_PUBLIC_SERVER_URL=http://localhost:3001
